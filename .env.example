# Obligatorio para habilitar el panel de secretaría.
ADMIN_PASSWORD=una-clave-larga-y-unica

# Dirección pública del portal, necesaria para los enlaces de correo.
PUBLIC_BASE_URL=http://localhost:3000

# Opcional: activa las suscripciones y el envío por Resend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=avisos@tu-dominio.cl

# Opcional: activa las notificaciones clicables del navegador.
# Genera las claves una sola vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.cl

PORT=3000
